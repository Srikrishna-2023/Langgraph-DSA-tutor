{
  "problems": [
    {
      "id": "two-sum-001",
      "topic": "two-pointer",
      "difficulty": "easy",
      "description": "Given an array of integers `nums` and an integer `target`, return the indices of the two numbers that add up to `target`. You may assume each input has exactly one solution.",
      "testcases": [
        {
          "target": 9,
          "array": [2, 7, 11, 15],
          "expected": [0, 1]
        },
        {
          "target": 6,
          "array": [3, 2, 4],
          "expected": [1, 2]
        }
      ]
    },
    {
      "id": "dutch-flag-001",
      "topic": "dutch national flag",
      "difficulty": "medium",
      "description": "Given an array containing only 0s, 1s, and 2s, sort the array in-place so all 0s come first, then all 1s, then all 2s.",
      "testcases": [
        {
          "array": [2, 0, 2, 1, 1, 0],
          "expected": [0, 0, 1, 1, 2, 2]
        },
        {
          "array": [2, 0, 1],
          "expected": [0, 1, 2]
        }
      ]
    },
    {
      "id": "reverse-linked-list-001",
      "topic": "linked list",
      "difficulty": "easy",
      "description": "Given the head of a singly linked list, reverse the list and return the reversed list.",
      "testcases": [
        {
          "list": [1, 2, 3, 4, 5],
          "expected": [5, 4, 3, 2, 1]
        },
        {
          "list": [1, 2],
          "expected": [2, 1]
        }
      ]
    },
    {
      "id": "merge-two-sorted-lists-001",
      "topic": "linked list",
      "difficulty": "easy",
      "description": "Given the heads of two sorted linked lists, merge them into one sorted linked list and return its head.",
      "testcases": [
        {
          "list1": [1, 2, 4],
          "list2": [1, 3, 4],
          "expected": [1, 1, 2, 3, 4, 4]
        },
        {
          "list1": [],
          "list2": [0],
          "expected": [0]
        }
      ]
    },
    {
      "id": "remove-nth-from-end-001",
      "topic": "linked list",
      "difficulty": "medium",
      "description": "Given the head of a linked list and an integer `n`, remove the nth node from the end of the list and return its head.",
      "testcases": [
        {
          "list": [1, 2, 3, 4, 5],
          "n": 2,
          "expected": [1, 2, 3, 5]
        },
        {
          "list": [1],
          "n": 1,
          "expected": []
        }
      ]
    },
    {
      "id": "middle-of-linked-list-001",
      "topic": "linked list",
      "difficulty": "easy",
      "description": "Given the head of a singly linked list, return the middle node of the linked list. If there are two middle nodes, return the second one.",
      "testcases": [
        {
          "list": [1, 2, 3, 4, 5],
          "expected": [3, 4, 5]
        },
        {
          "list": [1, 2, 3, 4, 5, 6],
          "expected": [4, 5, 6]
        }
      ]
    },
    {
      "id": "palindrome-linked-list-001",
      "topic": "linked list",
      "difficulty": "medium",
      "description": "Given the head of a singly linked list, determine whether the list is a palindrome.",
      "testcases": [
        {
          "list": [1, 2, 2, 1],
          "expected": true
        },
        {
          "list": [1, 2],
          "expected": false
        }
      ]
    },
    {
      "id": "max-depth-binary-tree-001",
      "topic": "tree",
      "difficulty": "easy",
      "description": "Given the root of a binary tree, return its maximum depth (the number of nodes along the longest path from the root down to the farthest leaf).",
      "testcases": [
        {
          "tree": [3, 9, 20, null, null, 15, 7],
          "expected": 3
        },
        {
          "tree": [1, null, 2],
          "expected": 2
        }
      ]
    },
    {
      "id": "invert-binary-tree-001",
      "topic": "tree",
      "difficulty": "easy",
      "description": "Given the root of a binary tree, invert the tree (swap every left and right child) and return its root.",
      "testcases": [
        {
          "tree": [4, 2, 7, 1, 3, 6, 9],
          "expected": [4, 7, 2, 9, 6, 3, 1]
        },
        {
          "tree": [2, 1, 3],
          "expected": [2, 3, 1]
        }
      ]
    },
    {
      "id": "level-order-traversal-001",
      "topic": "tree",
      "difficulty": "medium",
      "description": "Given the root of a binary tree, return the level order traversal of its nodes' values (i.e., from left to right, level by level).",
      "testcases": [
        {
          "tree": [3, 9, 20, null, null, 15, 7],
          "expected": [[3], [9, 20], [15, 7]]
        },
        {
          "tree": [1],
          "expected": [[1]]
        }
      ]
    },
    {
      "id": "validate-bst-001",
      "topic": "tree",
      "difficulty": "medium",
      "description": "Given the root of a binary tree, determine if it is a valid binary search tree (BST).",
      "testcases": [
        {
          "tree": [2, 1, 3],
          "expected": true
        },
        {
          "tree": [5, 1, 4, null, null, 3, 6],
          "expected": false
        }
      ]
    },
    {
      "id": "lowest-common-ancestor-bst-001",
      "topic": "tree",
      "difficulty": "medium",
      "description": "Given a binary search tree (BST) and two nodes `p` and `q`, find the lowest common ancestor (LCA) of the two nodes in the BST.",
      "testcases": [
        {
          "tree": [6, 2, 8, 0, 4, 7, 9, null, null, 3, 5],
          "p": 2,
          "q": 8,
          "expected": 6
        },
        {
          "tree": [6, 2, 8, 0, 4, 7, 9, null, null, 3, 5],
          "p": 2,
          "q": 4,
          "expected": 2
        }
      ]
    }
  ]
}